<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tech Burguer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caprasimo&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="tb-body">
    <!-- Top Navigation Bar -->
    <header class="tb-navbar">
        <div class="tb-container tb-nav-inner">
            <a asp-controller="Cardapio" asp-action="Index" class="tb-brand">
                <img src="~/images/logo-burger.svg" alt="Tech Burguer Logo" class="tb-brand-icon" />
                <div class="tb-brand-text">
                    <span class="tb-brand-title">Tech Burguer</span>
                    <span class="tb-brand-sub">MVC • GoF Design Patterns</span>
                </div>
            </a>

            <nav class="tb-nav-links">
                <a asp-controller="Cardapio" asp-action="Index"
                   class="tb-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cardapio" ? "active" : "")">
                    Cardápio
                </a>
                <a asp-controller="Pedido" asp-action="Montar"
                   class="tb-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Montar" ? "active" : "")">
                    Montar Pedido
                </a>
                <a asp-controller="Pedido" asp-action="Fila"
                   class="tb-nav-link tb-nav-pill @(ViewContext.RouteData.Values["action"]?.ToString() == "Fila" ? "active" : "")">
                    Fila de Pedidos
                </a>
            </nav>
        </div>
    </header>

    <main class="tb-main">
        @RenderBody()
    </main>

    <!-- Footer matching PDF Page 1 -->
    <footer class="tb-footer">
        <div class="tb-container">
            <div class="tb-footer-brand-row">
                <div class="tb-brand tb-footer-logo">
                    <span class="tb-brand-title">Tech Burguer</span>
                    <img src="~/images/doodle-leaf.svg" alt="Leaf" class="tb-footer-leaf" />
                </div>
            </div>

            <div class="tb-footer-grid">
                <div class="tb-footer-col">
                    <h4>ATENDIMENTO:</h4>
                    <p class="tb-footer-bold">QUARTA - DOMINGO:</p>
                    <p class="tb-footer-time">14:00 ÁS 22:00</p>
                </div>

                <div class="tb-footer-col tb-footer-contact">
                    <p class="tb-phone">+55 (11) 94301 - 4222</p>
                    <p class="tb-email">tecburguer@gmail.com</p>
                </div>

                <div class="tb-footer-col tb-footer-social">
                    <h4>FOLLOW US</h4>
                    <div class="tb-social-icons">
                        <!-- Facebook -->
                        <a href="#" class="tb-social-circle" aria-label="Facebook">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M14 13.5h2.5l1-4H14v-2c0-1.03.45-1.5 1.5-1.5h1.5V2.14c-.8-.11-1.8-.14-2.7-.14-2.8 0-4.8 1.7-4.8 4.9v2.6H7v4h2.5V22h4.5v-8.5z"/>
                            </svg>
                        </a>
                        <!-- Instagram -->
                        <a href="#" class="tb-social-circle" aria-label="Instagram">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                            </svg>
                        </a>
                        <!-- Twitter / X -->
                        <a href="#" class="tb-social-circle" aria-label="Twitter">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Checkerboard border at the very bottom -->
        <div class="tb-checkerboard"></div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
