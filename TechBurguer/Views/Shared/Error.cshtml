@{
    ViewData["Title"] = "Erro";
}

<section class="tb-obrigado-page">
    <div class="tb-container tb-obrigado-container">
        <div class="tb-ticket-card">
            <div class="tb-ticket-body">
                <p class="tb-ticket-client"><strong>Ops, algo deu errado.</strong></p>
                <p class="tb-ticket-desc">Não conseguimos concluir essa ação. Volte ao início e tente de novo.</p>
            </div>
            <div class="tb-ticket-footer">
                <div class="tb-ticket-actions">
                    <a asp-controller="Home" asp-action="Index" class="tb-btn-pill-green">Voltar ao início</a>
                </div>
            </div>
        </div>
    </div>
</section>
